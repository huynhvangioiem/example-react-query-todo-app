# Database (used by docker-compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=todoapp
MYSQL_USER=todoapp_user
MYSQL_PASSWORD=todoapp_password
MYSQL_PORT=3306

# Connection string for Prisma
DATABASE_URL="mysql://todoapp_user:todoapp_password@localhost:3306/todoapp"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-here" # openssl rand -base64 32

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
